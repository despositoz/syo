# TMDB v3 API key (read-only). https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=

# Optional: TMDB v4 read access token (Bearer). If set, it is used instead of the v3 key.
VITE_TMDB_ACCESS_TOKEN=

# Optional override of the TMDB API base (e.g. your own proxy).
VITE_TMDB_API_BASE=https://api.themoviedb.org/3

# Optional override of the TMDB image CDN base.
VITE_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# UI language passed to TMDB.
VITE_TMDB_LANGUAGE=ru-RU
